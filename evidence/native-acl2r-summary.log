ACL2(r) p!>>(DEFUN R2A-WRITE-RECEIPT (PATH EVENTS STATE)
             (DECLARE (XARGS :STOBJS STATE))
             (IF
              (NOT (R2A-CLEAN-WORLDP STATE))
              (ER
               SOFT 'R2A-EXPORT
               "Requires ACL2(r), proofs enabled, and no skipped proofs or trust tags.")
              (MV-LET (CHANNEL STATE)
                      (OPEN-OUTPUT-CHANNEL PATH
                                           :CHARACTER STATE)
               (IF (NOT CHANNEL)
                   (ER SOFT 'R2A-EXPORT
                       "Cannot write ~x0." PATH)
                (LET*
                 ((STATE
                      (PRINT-OBJECT$ (LIST :R2A-V1
                                           (F-GET-GLOBAL 'ACL2-VERSION STATE)
                                           (R2A-STRIP-PROOFS EVENTS))
                                     CHANNEL STATE))
                  (STATE (CLOSE-OUTPUT-CHANNEL CHANNEL STATE)))
                 (VALUE :R2A-EXPORTED))))))

