build/acl2
HOST: adc-sandbox

Environment variables:
ACL2_CUSTOMIZATION=NONE
ACL2_SYSTEM_BOOKS=/opt/acl2/books
ACL2=/opt/acl2/saved_acl2
ACL2_USELESS_RUNES=-25

Temp lisp file:
(acl2::value :q)
(acl2::in-package "ACL2")
; see github issue #638 (waterfall-parallelism and profiling): 
#+(and hons (not acl2-par)) (profile-fn 'prove)
#+(and hons (not acl2-par)) (profile-fn 'certify-book-fn)
#+(and hons (not acl2-par)) (profile-fn 'include-book-fn)
(acl2::lp)
(set-debugger-enable :bt)
(acl2::in-package "ACL2")

(set-ld-error-action (quote (:exit 1)) state)
(set-inhibit-output-lst (list (quote prove) (quote proof-tree) (quote warning) (quote observation) (quote event) (quote history)))

(acl2::assign acl2::get-internal-time-as-realtime acl2::t)
#-cmucl (acl2::gc-verbose t)
; instructions from .acl2 file import-tests.acl2:
; cert-flags: ? t :ttags ((:acl2r-checked-transfer))


; Prevent reset-prehistory while loading .port files
(acl2::assign acl2::skip-reset-prehistory acl2::t)
; portculli for included books:
(acl2::ld "std/testing/must-fail.port" :dir :SYSTEM :ld-missing-input-ok t :ld-always-skip-top-level-locals t)
(acl2::ld "transfer.port" :ld-missing-input-ok t :ld-always-skip-top-level-locals t)
(acl2::ld "rational-proofs.port" :ld-missing-input-ok t :ld-always-skip-top-level-locals t)
(acl2::ld "basel-interval.port" :ld-missing-input-ok t :ld-always-skip-top-level-locals t)
(acl2::ld "demo.port" :ld-missing-input-ok t :ld-always-skip-top-level-locals t)
(acl2::ld "example-import.port" :ld-missing-input-ok t :ld-always-skip-top-level-locals t)
#!ACL2 (set-ld-error-action (quote :continue) state)

; certify-book command flags: ? t :ttags ((:acl2r-checked-transfer))
#!ACL2 (er-progn (time$ (certify-book "import-tests" ? t :ttags ((:acl2r-checked-transfer))  ))
                                 (value (prog2$ #+hons (memsum)
                                                 #-hons nil
                                                 (exit 43))))
