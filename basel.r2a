
(:R2A-V1 "ACL2 Version 8.7(r)" ((DEFUN BASEL-SERIES (I N) (DECLARE (XARGS :MEASURE (NFIX (- N I)))) (IF (ZP (- N I)) 0 (+ (EXPT I -2) (BASEL-SERIES (1+ I) N)))) (DEFUN BASEL-ODDS (I N) (DECLARE (XARGS :MEASURE (NFIX (- N I)))) (IF (ZP (- N I)) 0 (+ (EXPT (- (* 2 I) 1) -2) (BASEL-ODDS (1+ I) N)))) (DEFUN BQ-PI-LO NIL 157079632679489661923/50000000000000000000) (DEFUN BQ-PI-HI NIL 314159265358979323847/100000000000000000000) (DEFUN BQ-ODD-ENCLOSUREP (N LO HI) (LET ((S (BASEL-ODDS 1 (1+ (EXPT 2 (1- N)))))) (AND (<= (* (EXPT LO 2) (- 1/8 (/ (EXPT 2 (+ N 3))))) S) (<= S (* 1/8 (EXPT HI 2)))))) (DEFUN BQ-FIXED-ODD-ENCLOSURE (N) (IMPLIES (POSP N) (BQ-ODD-ENCLOSUREP N (BQ-PI-LO) (BQ-PI-HI)))) (DEFUN BQ-SUM (N) (BASEL-SERIES 1 (1+ (NFIX N)))) (DEFUN BQ-DYADIC-LOWER (N LO) (- (/ (EXPT LO 2) 6) (/ (+ (EXPT LO 2) 2) (* 6 (EXPT 2 N))))) (DEFUN BQ-DYADIC-UPPER (HI) (/ (EXPT HI 2) 6)) (DEFUN BQ-DYADIC-ENCLOSUREP (N LO HI) (AND (<= (BQ-DYADIC-LOWER N LO) (BQ-SUM (EXPT 2 N))) (<= (BQ-SUM (EXPT 2 N)) (BQ-DYADIC-UPPER HI)))) (DEFUN BQ-ENCLOSURE-WIDTH (N LO HI) (+ (/ (- (EXPT HI 2) (EXPT LO 2)) 6) (/ (+ (EXPT LO 2) 2) (* 6 (EXPT 2 N))))) (DEFTHM BQ-FIXED-ODD-ENCLOSURE-EXPORT (BQ-FIXED-ODD-ENCLOSURE N) :RULE-CLASSES NIL)))