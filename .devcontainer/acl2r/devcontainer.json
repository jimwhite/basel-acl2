{
  "name": "Basel source: ACL2(r) (SBCL 2.6.10, ACL2 master + acl2r-context books/nonstd)",
  "build": {
    "dockerfile": "../Dockerfile",
    "context": "..",
    "args": {
      "ACL2_FLAVOR": "acl2r",
      "SBCL_VERSION": "2.6.10",
      "ACL2_REF": "master",
      "NONSTD_REF": "330a2344fa44d08fbd5fbf24c4b44a7473c9803d"
    }
  },
  "hostRequirements": { "cpus": 2, "memory": "8gb", "storage": "32gb" },
  "remoteUser": "vscode",
  "containerEnv": { "ACL2R": "/opt/acl2/saved_acl2r" },
  "postCreateCommand": "echo \"ACL2 commit: $(cat /opt/acl2/ACL2_COMMIT); books/nonstd: $(cat /opt/acl2/NONSTD_COMMIT)\"; sbcl --version",
  "customizations": {
    "vscode": {
      "extensions": ["mattn.lisp"]
    }
  }
}
