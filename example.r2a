
(:R2A-V1 "ACL2 Version 8.7(r)" ((DEFUN RATIONAL-DOUBLE (X) (* 2 (IFIX X))) (DEFTHM DOUBLE-IS-RATIONAL (RATIONALP (RATIONAL-DOUBLE X)) :RULE-CLASSES NIL) (ENCAPSULATE ((PORTABLE-HALF (X) T)) (LOCAL (DEFUN PORTABLE-HALF (X) (/ (IFIX X) 2))) (LOCAL (DEFUN PORTABLE-HELPER (X) (PORTABLE-HALF X))) (LOCAL (DEFTHM HELPER-RATIONAL (RATIONALP (PORTABLE-HELPER X)) :RULE-CLASSES NIL)) (DEFTHM HALF-RATIONAL (RATIONALP (PORTABLE-HALF X)) :RULE-CLASSES NIL))))